# The harness runs on Linux (developed on Kali under WSL 2). Scripts and
# configs must keep LF line endings, or bash and mosquitto fail when the tree
# is checked out on a machine with core.autocrlf enabled.
* text=auto eol=lf

*.sh    text eol=lf
*.py    text eol=lf
*.conf  text eol=lf
acl     text eol=lf
*.csv   text eol=lf
*.log   text eol=lf
*.md    text eol=lf

*.png   binary
